# 复制为 backend/.env 后填写；backend/.env 已被 .gitignore 忽略，不要提交。
# dev | production（默认 production）。TEAMS_WEBHOOK_ALLOW_INSECURE_LOCAL 只在 dev 下生效。
TEAMS_ENV=dev
TEAMS_HTTP_ADDR=127.0.0.1:8090
TEAMS_PUBLIC_BASE_URL=http://127.0.0.1:8090
TEAMS_DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@127.0.0.1:5432/teams_dev?sslmode=disable
# 集成测试用（go test 会清空这个库的 public schema）
TEAMS_TEST_DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@127.0.0.1:5432/teams_test?sslmode=disable
TEAMS_SECRET_KEY=<32_BYTE_BASE64_KEY>
TEAMS_UPLOAD_DIR=./data/uploads
TEAMS_CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190
TEAMS_SESSION_TTL=720h
TEAMS_MAX_IMAGE_BYTES=10485760
TEAMS_MAX_VIDEO_BYTES=104857600
TEAMS_MAX_AVATAR_BYTES=5242880
TEAMS_MAX_TRIGGER_DEPTH=3
TEAMS_WEBHOOK_RATE_PER_MINUTE=10
TEAMS_WEBHOOK_TIMEOUT=10s
TEAMS_WEBHOOK_WORKERS=4
# 允许 http:// 与内网/本机地址的 webhook 和头像拉取（仅本地调试；默认 false）
TEAMS_WEBHOOK_ALLOW_INSECURE_LOCAL=false
TEAMS_AUTH_RATE_PER_MINUTE=20
TEAMS_INVITE_PREVIEW_RATE_PER_MINUTE=30
TEAMS_LOG_LEVEL=info
