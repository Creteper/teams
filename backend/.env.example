# 复制为 backend/.env 后填写；backend/.env 已被 .gitignore 忽略，不要提交。
TEAMS_HTTP_ADDR=127.0.0.1:8090
TEAMS_PUBLIC_BASE_URL=http://127.0.0.1:8090
TEAMS_DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@127.0.0.1:5432/teams?sslmode=disable
TEAMS_SECRET_KEY=<32_BYTE_BASE64_KEY>
TEAMS_UPLOAD_DIR=./data/uploads
TEAMS_CORS_ORIGINS=http://localhost:5173
TEAMS_SESSION_TTL=720h
TEAMS_MAX_IMAGE_BYTES=10485760
TEAMS_MAX_VIDEO_BYTES=104857600
TEAMS_MAX_TRIGGER_DEPTH=3
TEAMS_WEBHOOK_RATE_PER_MINUTE=10
TEAMS_WEBHOOK_TIMEOUT=10s
TEAMS_WEBHOOK_ALLOW_PRIVATE=false
TEAMS_LOG_LEVEL=info
